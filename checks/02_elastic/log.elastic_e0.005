# Static 0 K elastic constants C11, C12, C44 of bcc Fe (Mendelev 2003 EAM/FS, Fe_mm.eam.fs).
# Cell: relaxed 5x5x5 bcc (250 atoms), x=[100] y=[010] z=[001], from checks/01_lattice.
# Usage: lmp -in in.elastic -var e 0.001
#
# Strain definitions:
#   C11, C12: normal strain eps_xx = +-e  (lx -> lx*(1+-e)).
#   C44:      tilt xy = +-e*ly, i.e. ENGINEERING shear strain gamma_xy = 2*eps_xy = +-e.
#             Voigt: sigma_xy = C44*gamma_xy, so C44 = -(Pxy(+e)-Pxy(-e))/(2e).
# Sign convention: LAMMPS reports pressure P_ij = -sigma_ij (stress, tension positive), in bar.
#   C11 = -(Pxx(+e)-Pxx(-e))/(2e),  C12 = -(Pyy(+e)-Pyy(-e))/(2e),  1 GPa = 10000 bar.

variable  ep   equal  ${e}
variable  ep   equal  0.005
variable  em   equal  -${e}
variable  em   equal  -0.005

variable  mode string x
variable  tag  string x_plus
variable  e    delete
variable  e    equal ${ep}
variable  e    equal 0.005
include   strain.mod
# One strained state. Needs: ${mode} (x or xy), ${e} (signed strain), ${tag}.
# Starts fresh from the relaxed 250-atom cell of checks/01_lattice.
clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
units           metal
boundary        p p p
atom_style      atomic
read_data       ../01_lattice/relaxed.data
Reading data file ...
  orthogonal box = (-0.00081214997 -0.00081214997 -0.00081214997) to (14.275812 14.275812 14.275812)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  250 atoms
  reading velocities ...
  250 velocities
  read_data CPU = 0.002 seconds
change_box      all triclinic
Changing box ...
  triclinic box = (-0.00081214997 -0.00081214997 -0.00081214997) to (14.275812 14.275812 14.275812) with tilt (0 0 0)
pair_style      eam/fs
pair_coeff      * * ../../potentials/Fe_mm.eam.fs Fe
Reading eam/fs potential file ../../potentials/Fe_mm.eam.fs with DATE: 2007-06-11
thermo_style    custom step pe pxx pyy pzz pxy pxz pyz
thermo_modify   format float %.10g

variable        L0 equal lx
variable        s  equal 1.0+${e}
variable        s  equal 1.0+0.005
variable        t  equal ${e}*ly
variable        t  equal 0.005*ly
if "${mode} == x"  then "change_box all x scale ${s} remap units box"
change_box all x scale ${s} remap units box
change_box all x scale 1.005 remap units box
Changing box ...
  triclinic box = (-0.036503711 -0.00081214997 -0.00081214997) to (14.311504 14.275812 14.275812) with tilt (0 0 0)
# Shear: tilt xy = e*ly, so the ENGINEERING shear strain gamma_xy = e (tensor eps_xy = e/2)
if "${mode} == xy" then "change_box all xy final ${t} remap units box"

