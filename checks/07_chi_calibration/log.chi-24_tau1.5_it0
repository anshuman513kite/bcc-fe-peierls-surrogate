variable        om equal 2.8553^3/2*(1+-0.0000000000)*(1+${eyy})*(1+${ezz})*count(int)*1e4
variable        om equal 2.8553^3/2*(1+-0.0000000000)*(1+0)*(1+${ezz})*count(int)*1e4
