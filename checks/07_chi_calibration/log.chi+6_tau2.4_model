LAMMPS (22 Jul 2025 - Update 6)
  using 1 OpenMP thread(s) per MPI task
# Perfect bcc Fe (Mendelev 2003 #2) in the screw frame x = [111], y = [-110], z = [-1-12], under a homogeneous box strain.
# Box from the true repeats a*sqrt3 x a*sqrt2 x a*sqrt6 (5 x 10 x 4), as checks/03_tilt_xz. a = 2.8553 A.
# geom = block: fully periodic.  geom = slab: y non-periodic (free faces, shrink-wrapped), optional surface forces.
# Strain (engineering shears): stretches first (x, y, z scale 1+eps), then tilts xy = gxy*Ly, xz = gxz*Lz, yz = gyz*Lz.
# Slab surface forces: +fx on the top 2 (-110) planes, -fx on the bottom 2, fx = sxy*Lx*Lz/N_slab (fix_modify energy yes).
# Stress: block -> global pressure; both -> interior average of stress/atom (|y - ymid| < 8 A), sigma = sum/(N*Omega),
#   Omega = (a^3/2)(1+exx)(1+eyy)(1+ezz) (eyy of the slab is not imposed: Omega uses the imposed eyy = 0, error <= 0.3 %).
# Sign convention: LAMMPS pressure P_ij = -sigma_ij; stress/atom summed / volume = sigma (tension positive). Output in GPa.
# Vars: geom tag exx eyy ezz gyz gxz gxy sxy
variable        a equal 2.8553
units           metal
atom_style      atomic
if "${geom} == block" then "boundary p p p" else "boundary p s p"
boundary p s p
lattice         bcc ${a} orient x 1 1 1 orient y -1 1 0 orient z -1 -1 2
lattice         bcc 2.8553 orient x 1 1 1 orient y -1 1 0 orient z -1 -1 2
Lattice spacing in x,y,z = 4.9455247 4.038004 4.6626854
region          box prism 0 $(5*v_a*sqrt(3)) -5 $(10*v_a*sqrt(2)+5) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          box prism 0 24.727623354257076471 -5 $(10*v_a*sqrt(2)+5) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          box prism 0 24.727623354257076471 -5 45.380039846438990025 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          box prism 0 24.727623354257076471 -5 45.380039846438990025 0 27.976112250275232185 0 0 0 units box
region          xtal prism 0 $(5*v_a*sqrt(3)) -0.001 $(10*v_a*sqrt(2)-0.001) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          xtal prism 0 24.727623354257076471 -0.001 $(10*v_a*sqrt(2)-0.001) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          xtal prism 0 24.727623354257076471 -0.001 40.379039846438992356 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          xtal prism 0 24.727623354257076471 -0.001 40.379039846438992356 0 27.976112250275232185 0 0 0 units box
if "${geom} == block" then "region box delete" "region box prism 0 $(5*v_a*sqrt(3)) 0 $(10*v_a*sqrt(2)) 0 $(4*v_a*sqrt(6)) 0 0 0 units box"
create_box      1 box
