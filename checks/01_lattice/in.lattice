units           metal
boundary        p p p
atom_style      atomic
lattice         bcc 2.855
region          box block 0 5 0 5 0 5
create_box      1 box
create_atoms    1 box
mass            1 55.845
pair_style      eam/fs
pair_coeff      * * ../../potentials/Fe_mm.eam.fs Fe
thermo_style    custom step pe lx press
fix             1 all box/relax iso 0.0 vmax 0.001
min_style       cg
minimize        1e-12 1e-12 10000 100000
variable        a equal lx/5
variable        ecoh equal pe/atoms
print           "RESULT a0 = ${a} Angstrom"
print           "RESULT Ecoh = ${ecoh} eV/atom"
variable        pfinal equal press
print           "RESULT press_final = ${pfinal} bar"
write_data      relaxed.data
