region          xtal prism 0 $(5*v_a*sqrt(3)) -0.001 $(10*v_a*sqrt(2)-0.001) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          xtal prism 0 24.727623354257076471 -0.001 $(10*v_a*sqrt(2)-0.001) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          xtal prism 0 24.727623354257076471 -0.001 40.379039846438992356 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region          xtal prism 0 24.727623354257076471 -0.001 40.379039846438992356 0 27.976112250275232185 0 0 0 units box
if "${geom} == block" then "region box delete" "region box prism 0 $(5*v_a*sqrt(3)) 0 $(10*v_a*sqrt(2)) 0 $(4*v_a*sqrt(6)) 0 0 0 units box"
region box delete
region box prism 0 $(5*v_a*sqrt(3)) 0 $(10*v_a*sqrt(2)) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region box prism 0 24.727623354257076471 0 $(10*v_a*sqrt(2)) 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region box prism 0 24.727623354257076471 0 40.380039846438990025 0 $(4*v_a*sqrt(6)) 0 0 0 units box
region box prism 0 24.727623354257076471 0 40.380039846438990025 0 27.976112250275232185 0 0 0 units box
create_box      1 box
