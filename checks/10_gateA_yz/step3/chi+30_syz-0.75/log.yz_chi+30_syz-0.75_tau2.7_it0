variable        ymid equal $(0.5*(bound(all,ymin)+bound(all,ymax)))
variable        ymid equal 19.180518927058514578
variable        d110 equal v_a*sqrt(2)/2
region          rtop block INF INF $(bound(all,ymax)-1.5*v_d110) INF INF INF units box
region          rtop block INF INF 35.332534865634102061 INF INF INF units box
region          rbot block INF INF INF $(bound(all,ymin)+1.5*v_d110) INF INF units box
region          rbot block INF INF INF 3.0285029884829253177 INF INF units box
region          rint block INF INF $(v_ymid-8) $(v_ymid+8) INF INF units box
region          rint block INF INF 11.180518927058500367 $(v_ymid+8) INF INF units box
region          rint block INF INF 11.180518927058500367 27.180518927058500367 INF INF units box
group           top region rtop
240 atoms in group top
group           bot region rbot
240 atoms in group bot
group           int region rint
960 atoms in group int
variable        fx equal ${sxy}*lx*lz*0.0062415091/count(top)
variable        fx equal 2.3382685902*lx*lz*0.0062415091/count(top)
variable        fz equal ${syz}*lx*lz*0.0062415091/count(top)
variable        fz equal -0.7500000000*lx*lz*0.0062415091/count(top)
fix             ftop top addforce $(v_fx) 0.0 $(v_fz)
fix             ftop top addforce 0.042223976911183000449 0.0 $(v_fz)
fix             ftop top addforce 0.042223976911183000449 0.0 -0.013543346908953099797
fix             fbot bot addforce $(-v_fx) 0.0 $(-v_fz)
fix             fbot bot addforce -0.042223976911183000449 0.0 $(-v_fz)
fix             fbot bot addforce -0.042223976911183000449 0.0 0.013543346908953099797
fix_modify      ftop energy yes
fix_modify      fbot energy yes
compute         sa all stress/atom NULL
compute         ss int reduce sum c_sa[1] c_sa[2] c_sa[3] c_sa[4] c_sa[5] c_sa[6]
variable        om equal ${a}^3/2*(1+${exx})*(1+${ezz})*count(int)*1e4
variable        om equal 2.8553^3/2*(1+${exx})*(1+${ezz})*count(int)*1e4
variable        om equal 2.8553^3/2*(1+0.0000000000)*(1+${ezz})*count(int)*1e4
variable        om equal 2.8553^3/2*(1+0.0000000000)*(1+0.0037293750)*count(int)*1e4
thermo_style    custom step pe fmax pxx pyy pzz pyz pxz pxy
min_style       cg
minimize        1e-15 1e-15 20000 200000
